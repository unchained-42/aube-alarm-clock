<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing excluded from cloud backup or device-to-device transfer: every setting the app
    stores (wake windows, dawn duration, reminders, the QR dismiss payload) is harmless to
    back up, and losing it would be a real UX regression on a device switch.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
