<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Aube" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aube_night</item>
        <item name="android:statusBarColor">@color/aube_night</item>
        <item name="android:navigationBarColor">@color/aube_night</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.Aube.Alarm" parent="Theme.Aube">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
